---
import Layout from '../layouts/Layout.astro';
import UpcomingMaintenance from '../components/UpcomingMaintenance.astro';
import statusData from '../../status.json';
import manualData from '../../manual_status.json';
import maintenanceInfo from '../../maintenance_info.json';

const icons = {
  ok: `<svg class="status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>`,
  warn: `<svg class="status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`,
  down: `<svg class="status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>`,
  unknown: `<svg class="status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`,
  maintenance: `<svg class="status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>`
};

function getBannerState(data: any, manualData: any) {
  const isAllOk = data.system_status === 'all_systems_operational';
  let bannerClass = isAllOk ? 'banner-ok' : 'banner-warning';
  let title = isAllOk ? 'すべてのシステムが正常に稼働しています' : '一部のシステムに問題が発生しています';
  let icon = isAllOk ? icons.ok : icons.warn;
  let description = '';

  if (manualData?.maintenance?.active) {
    bannerClass = 'banner-maintenance';
    icon = icons.maintenance;
    title = manualData.maintenance.title || 'システムメンテナンス中です';
    description = manualData.maintenance.description || '';
  } else if (manualData?.incident?.active) {
    bannerClass = 'banner-down';
    icon = icons.down;
    title = manualData.incident.title || 'システム障害が発生しています';
    description = manualData.incident.description || '';
  }

  return { class: bannerClass, title, icon, description };
}

function getStatusBadge(service: any, manualData: any) {
  const maintenanceActive = manualData?.maintenance?.active &&
    (manualData.maintenance.id?.includes('all') || manualData.maintenance.id?.includes(service.id));
  const incidentActive = manualData?.incident?.active &&
    (manualData.incident.id?.includes('all') || manualData.incident.id?.includes(service.id));

  if (maintenanceActive) {
    return { icon: icons.maintenance, text: 'メンテ中', class: 'status-maintenance', latency: '-' };
  }

  if (incidentActive) {
    return { icon: icons.down, text: '障害中', class: 'status-down', latency: '-' };
  }

  const latency = typeof service.latency_ms === 'number' ? `${service.latency_ms} ms` : '-';

  if (service.status === 'degraded') {
    return { icon: icons.warn, text: '警告・遅延', class: 'status-warn', latency };
  }

  if (service.status === 'down') {
    return { icon: icons.down, text: '停止中', class: 'status-down', latency };
  }

  if (service.status === 'unknown') {
    return { icon: icons.unknown, text: '不明', class: 'status-unknown', latency };
  }

  return { icon: icons.ok, text: '稼働中', class: 'status-ok', latency };
}

const bannerState = getBannerState(statusData, manualData);
const updatedAt = new Date(statusData.last_updated).toLocaleString('ja-JP', {
  timeZone: 'Asia/Tokyo',
  month: 'short',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit'
});
---

<Layout title="Heyete System Status(臨時)" canonical="/">
  <div class="status-wrapper">
    <h1 class="page-title">このページはメインのステータスページが利用できない場合の予備です。</h1>

    <div class={`overall-banner ${bannerState.class} fade-in`} style="--delay: 0s">
      <div class="banner-icon" set:html={bannerState.icon}></div>
      <div class="banner-text">
        <h2>{bannerState.title}</h2>
        {bannerState.description && <p class="banner-desc">{bannerState.description}</p>}
        <p class="update-time">最終更新: {updatedAt}(JST)</p>
      </div>
    </div>
  

    <UpcomingMaintenance items={maintenanceInfo} />

    {statusData.api_services?.length ? (
      <section class="service-group fade-in" style="--delay: 0.1s">
        <h3 class="group-title">APIサービス</h3>
        <div class="service-list">
          {statusData.api_services.map((service: any) => {
            const badge = getStatusBadge(service, manualData);
            return (
              <div class="service-row" key={service.id}>
                <div class="service-name">{service.name}</div>
                <div class="service-details">
                  <span class="latency">{badge.latency}</span>
                  <div class={`status-badge ${badge.class}`}>
                    <span class="status-icon" set:html={badge.icon}></span>
                    <span>{badge.text}</span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ) : null}

    {statusData.web_services?.length ? (
      <section class="service-group fade-in" style="--delay: 0.2s">
        <h3 class="group-title">Webサービス</h3>
        <div class="service-list">
          {statusData.web_services.map((service: any) => {
            const badge = getStatusBadge(service, manualData);
            return (
              <div class="service-row" key={service.id}>
                <div class="service-name">{service.name}</div>
                <div class="service-details">
                  <span class="latency">{badge.latency}</span>
                  <div class={`status-badge ${badge.class}`}>
                    <span class="status-icon" set:html={badge.icon}></span>
                    <span>{badge.text}</span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    ) : null}
  </div>
</Layout>

<style is:global>
  html {
    overflow-y: scroll;
  }

  .page-title {
    margin: 0 0 1.5rem;
    font-size: 1.25rem;
    color: #1f2937;
  }

  .status-wrapper {
    max-width: 800px;
    margin: 2rem auto;
  }

  .fade-in {
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
    animation-delay: var(--delay, 0s);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .overall-banner {
    display: flex;
    align-items: center;
    padding: 1.5rem;
    border-radius: 12px;
    margin-bottom: 2.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .banner-ok {
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
  }

  .banner-warning {
    background-color: #fefce8;
    border: 1px solid #fef08a;
  }

  .banner-maintenance {
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
  }

  .banner-down {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
  }

  .banner-icon svg {
    width: 40px;
    height: 40px;
    margin-right: 1.2rem;
  }

  .banner-ok .banner-icon svg {
    color: #16a34a;
  }

  .banner-warning .banner-icon svg {
    color: #ca8a04;
  }

  .banner-maintenance .banner-icon svg {
    color: #2563eb;
  }

  .banner-down .banner-icon svg {
    color: #dc2626;
  }

  .banner-text h2 {
    margin: 0 0 0.2rem 0;
    font-size: 1.25rem;
  }

  .banner-desc {
    font-size: 0.95rem;
    color: #4b5563;
    margin: 0.5rem 0 0.8rem 0;
    line-height: 1.4;
  }

  .update-time {
    margin: 0;
    font-size: 0.85rem;
    color: #666;
  }

  .service-group {
    margin-bottom: 2.5rem;
  }

  .group-title {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    padding-left: 0.5rem;
    border-left: 4px solid #0056b3;
    color: #333;
  }

  .service-list {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    border: 1px solid #eaeaea;
  }

  .service-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 1.5rem;
    border-bottom: 1px solid #eaeaea;
  }

  .service-row:last-child {
    border-bottom: none;
  }

  .service-name {
    font-weight: 500;
    font-size: 1rem;
  }

  .service-details {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .latency {
    font-size: 0.9rem;
    color: #888;
    min-width: 60px;
    text-align: right;
  }

  .status-badge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    border-radius: 20px;
    min-width: 90px;
    justify-content: center;
  }

  .status-icon {
    width: 16px;
    height: 16px;
  }

  .status-ok {
    background: #f0fdf4;
    color: #16a34a;
  }

  .status-warn {
    background: #fefce8;
    color: #ca8a04;
  }

  .status-down {
    background: #fef2f2;
    color: #dc2626;
  }

  .status-unknown {
    background: #f3f4f6;
    color: #4b5563;
  }

  .status-maintenance {
    background: #eff6ff;
    color: #2563eb;
  }
</style>
