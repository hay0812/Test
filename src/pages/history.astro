---
import Layout from '../layouts/Layout.astro';
import maintenanceInfo from '../../maintenance_info.json';

const now = new Date().getTime();

const scheduled = maintenanceInfo
  .filter((m) => new Date(m.endAt).getTime() > now)
  .sort((a, b) => new Date(a.startAt).getTime() - new Date(b.startAt).getTime());

const past = maintenanceInfo
  .filter((m) => new Date(m.endAt).getTime() <= now)
  .sort((a, b) => new Date(b.startAt).getTime() - new Date(a.startAt).getTime());

const timeOptions = {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
};

const formatTime = (raw) => new Date(raw).toLocaleString('ja-JP', timeOptions);

const scheduledHtml = scheduled.length === 0
  ? '<p class="empty-text">現在、予定されているメンテナンスはありません。</p>'
  : `<ul class="maint-list">${scheduled
      .map((m) =>
        `<li class="maint-item"><div class="maint-header"><span class="maint-time">${formatTime(
          m.startAt
        )} 〜 ${formatTime(m.endAt)}</span><span class="badge badge-scheduled">予定</span></div><div class="maint-title">${m.title}</div><div class="maint-desc">${m.description}</div></li>`
      )
      .join('')}</ul>`;

const pastHtml = past.length === 0
  ? '<p class="empty-text">過去のメンテナンス履歴はありません。</p>'
  : `<ul class="maint-list">${past
      .map((m) =>
        `<li class="maint-item"><div class="maint-header"><span class="maint-time">${formatTime(
          m.startAt
        )} 〜 ${formatTime(m.endAt)}</span><span class="badge badge-completed">完了</span></div><div class="maint-title">${m.title}</div><div class="maint-desc">${m.description}</div></li>`
      )
      .join('')}</ul>`;
---

<Layout title="メンテナンス履歴・予定 - Heyete System Status(臨時)" canonical="/history/">
  <div class="status-wrapper">
    <div class="header-nav fade-in" style="--delay: 0s">
      <a href="/" class="back-link">← 現在のステータスに戻る</a>
      <h2>メンテナンス履歴・予定</h2>
    </div>

    <div class="history-section fade-in" style="--delay: 0.1s">
      <h3 class="section-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        今後のメンテナンス予定
      </h3>
      <div class="history-card" set:html={scheduledHtml}></div>
    </div>

    <div class="history-section fade-in" style="--delay: 0.2s">
      <h3 class="section-title">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        過去のメンテナンス履歴
      </h3>
      <div class="history-card" set:html={pastHtml}></div>
    </div>
  </div>
</Layout>

<style>
  :global(body) {
    margin: 0;
  }

  .fade-in {
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
    animation-delay: var(--delay, 0s);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(15px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .status-wrapper {
    max-width: 800px;
    margin: 2rem auto;
  }

  .header-nav {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-block;
    color: #2563eb;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #1d4ed8;
    text-decoration: underline;
  }

  .header-nav h2 {
    margin: 0;
    font-size: 1.5rem;
    color: #1e293b;
  }

  .history-section {
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 1.15rem;
    color: #334155;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-left: 0.5rem;
  }

  .icon {
    width: 22px;
    height: 22px;
    color: #334155;
  }

  .history-card {
    background: #fff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    padding: 1.25rem;
  }

  .maint-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .maint-item {
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1rem;
    background: #ffffff;
  }

  .maint-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .maint-time {
    font-size: 0.9rem;
    color: #2563eb;
    font-weight: 600;
  }

  .badge {
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .badge-scheduled {
    background: #eff6ff;
    color: #1d4ed8;
  }

  .badge-completed {
    background: #f0fdf4;
    color: #166534;
  }

  .maint-title {
    font-size: 1rem;
    color: #1e293b;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .maint-desc {
    margin: 0;
    color: #475569;
    line-height: 1.6;
  }

  .empty-text {
    color: #64748b;
    font-size: 0.95rem;
    margin: 0;
  }
</style>
